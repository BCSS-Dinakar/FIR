MONGO_URI=mongodb+srv://<username>:<db_password>@<cluster-host>/?appName=<app-name>

DATABASE_NAME=legal_database
COLLECTION_NAME=laws_sections

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

FAISS_INDEX_PATH=faiss_index

CHUNK_SIZE=900
CHUNK_OVERLAP=150

DEFAULT_TOP_K=5
MAX_TOP_K=20
SIMILARITY_SCORE_THRESHOLD=1.35

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest
MISTRAL_FALLBACK_MODEL=mistral-small-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_TEMPERATURE=0.1
MISTRAL_MAX_OUTPUT_TOKENS=800
MISTRAL_MAX_RETRIES=3
