PORT=5000
MONGO_URI=mongodb+srv://<username>:<db_password>@<cluster-host>/firaudit?appName=<app-name>
JWT_SECRET=change_me
NODE_ENV=development

# PostgreSQL primary (legislative)
POSTGRES_HOST=103.211.36.242
POSTGRES_PORT=5432
POSTGRES_DB=legislative
POSTGRES_USER=legislative
POSTGRES_PASSWORD=change_me
PG_PRIMARY=true
MONGO_SYNC=true
MONGO_FALLBACK=true

# Legal corpus identifiers (legacy Mongo names; PG tables are laws_*)
DATABASE_NAME=legal_database
COLLECTION_NAME=laws_sections

# vLLM — OpenAI-compatible text generation (shared across apps)
VLLM_BASE_URL=http://100.49.109.96/v1
VLLM_API_KEY=your-key-here
VLLM_MODEL=qwen3:14b-awq
VLLM_FALLBACK_MODEL=
VLLM_TEMPERATURE=0.1
VLLM_MAX_OUTPUT_TOKENS=800
VLLM_MAX_RETRIES=3
VLLM_DISABLE_THINKING=true

# Embeddings — separate OpenAI-compatible endpoint (NOT the chat model)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=50
EMBEDDING_BATCH_PACE_MS=500
EMBEDDING_MAX_RETRIES=3

# OCR — vision endpoint (separate from vLLM Qwen text generation)
OCR_BASE_URL=http://98.86.63.69/v1
OCR_API_KEY=your-key-here
# Primary: paddleocr-vl:0.9b (images: OCR: prompt via chat; docs: /v1/ocr/extract)
OCR_MODEL=paddleocr-vl:0.9b
# Profile: petition (default) | form | table — applies to image chat OCR only
OCR_PROFILE=petition
# Optional: override any profile (leave empty to use built-in prompts)
OCR_PROMPT=
# Optional per-profile overrides: OCR_PROMPT_PETITION, OCR_PROMPT_FORM, OCR_PROMPT_TABLE
# Paddle default/cap: 1024 / 2048. VLM default: 4096. Paddle values above 2048 are clamped.
OCR_MAX_TOKENS=1024
OCR_MAX_RETRIES=3
# Document OCR (PDF/DOCX/DOC): POST {OCR_BASE_URL}/ocr/extract or /ocr/extract/json
# Images only: POST {OCR_BASE_URL}/chat/completions with image_url + OCR: prompt

# pgvector ingest: run scripts/ingestLawEmbeddings.js after DBA installs:
#   CREATE EXTENSION vector;
