# vLLM — OpenAI-compatible text generation (shared with backend)
VLLM_BASE_URL=http://100.49.109.96/v1
VLLM_API_KEY=your-key-here
VLLM_MODEL=qwen3:14b-awq
VLLM_TEMPERATURE=0.1
VLLM_MAX_OUTPUT_TOKENS=800
VLLM_MAX_RETRIES=3

# MongoDB / PostgreSQL — see backend/.env.example for corpus connection vars
MONGO_URI=mongodb://localhost:27017/
DATABASE_NAME=legal_database
COLLECTION_NAME=laws_sections

# Local embeddings (unchanged — not routed through vLLM chat)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=faiss_index
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
SIMILARITY_SCORE_THRESHOLD=1.35
