# ----------------------------------------------------
# Police Petition Analyzer - Environment Variables
# ----------------------------------------------------

# Google Gemini API Key
# Required to perform OCR, Translation, Validation, and Legal Mapping
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Node Server Port. Defaults to 3000 if not specified.
PORT=3000
